# Run python -m scripts.setup_env to generate matching credentials.
APPLICATION_NAME=HaliçMind
POSTGRES_PASSWORD=
DATABASE_URL=
# Production: Supabase Session pooler URL with sslmode=require.
# DATABASE_SCHEMA=halicmind
# PUBLIC_ORIGIN=https://halicmind.onrender.com
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM=HalicMind <noreply@your-verified-domain.example>
# Domain-free Gmail alternative (HTTPS API, not SMTP):
# MAIL_PROVIDER=gmail
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER=halicmind@gmail.com
# Generate a private key with scripts.setup_env; never use a shared sample key.
JWT_SECRET_KEY=
# Microsoft school sign-in (Web client, multi-tenant organizations).
# Google Classroom (separate Web client; leave Gmail sender credentials unchanged).
# CLASSROOM_CLIENT_ID=
# CLASSROOM_CLIENT_SECRET=
# INTEGRATION_ENCRYPTION_KEY=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# School tenant is pinned in application code; PUBLIC_ORIGIN is required.
ACCESS_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=15
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS_MODE=none
SMTP_FROM=noreply@halicmind.local
# For a real SMTP provider: use starttls (often port 587) or ssl (often 465).
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Official exam announcements are polled while FastAPI is running.
EXAM_SYNC_ENABLED=true
EXAM_SYNC_INTERVAL_SECONDS=3600
# Optional custom CA bundle; certificate validation always remains enabled.
# EXAM_SYNC_CA_BUNDLE=
